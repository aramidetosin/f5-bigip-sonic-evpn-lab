{
  "class": "AS3",
  "action": "deploy",
  "declaration": {
    "class": "ADC",
    "schemaVersion": "3.56.0",
    "id": "f5lab-part21-complete",
    "label": "part 3's application, declared",
    "f5lab_as3": {
      "class": "Tenant",
      "web": {
        "class": "Application",
        "template": "http",
        "serviceMain": {
          "class": "Service_HTTP",
          "virtualAddresses": [
            "10.20.30.110"
          ],
          "virtualPort": 80,
          "pool": "web_pool",
          "snat": "auto"
        },
        "web_pool": {
          "class": "Pool",
          "loadBalancingMode": "round-robin",
          "monitors": [
            {
              "use": "http_app"
            }
          ],
          "members": [
            {
              "servicePort": 80,
              "serverAddresses": [
                "10.20.0.11",
                "10.20.0.12",
                "10.20.0.13"
              ]
            }
          ]
        },
        "http_app": {
          "class": "Monitor",
          "monitorType": "http",
          "send": "GET / HTTP/1.1\r\nHost: as3.f5lab.test\r\nConnection: close\r\n\r\n",
          "receive": "200 OK",
          "interval": 5,
          "timeout": 16
        }
      }
    },
    "updateMode": "complete"
  }
}
