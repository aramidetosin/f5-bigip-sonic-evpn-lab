{
  "class": "AS3",
  "action": "deploy",
  "declaration": {
    "class": "ADC",
    "schemaVersion": "3.56.0",
    "id": "f5lab-part21",
    "label": "part 3's application, declared: version 3, matching part 3",
    "f5lab_as3": {
      "class": "Tenant",
      "web": {
        "class": "Application",
        "template": "http",
        "serviceMain": {
          "class": "Service_HTTP",
          "virtualAddresses": [
            "10.20.30.110"
          ],
          "virtualPort": 80,
          "pool": "web_pool",
          "snat": "auto",
          "profileTCP": {
            "bigip": "/Common/tcp"
          },
          "persistenceMethods": []
        },
        "web_pool": {
          "class": "Pool",
          "loadBalancingMode": "round-robin",
          "monitors": [
            {
              "bigip": "/Common/http-app"
            }
          ],
          "members": [
            {
              "servicePort": 80,
              "serverAddresses": [
                "10.20.0.11",
                "10.20.0.12",
                "10.20.0.13"
              ]
            }
          ]
        }
      }
    },
    "controls": {
      "class": "Controls",
      "dryRun": true,
      "traceResponse": true
    }
  }
}
