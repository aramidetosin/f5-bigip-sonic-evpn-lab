{
  "class": "AS3",
  "action": "deploy",
  "declaration": {
    "class": "ADC",
    "schemaVersion": "3.56.0",
    "id": "f5lab-part21-team-b",
    "label": "another team's tenant: a pool only",
    "f5lab_teamb": {
      "class": "Tenant",
      "shared": {
        "class": "Application",
