        "api_pool": {
          "class": "Pool",
          "loadBalancingMode": "round-robin",
          "monitors": [
            {
              "bigip": "/Common/http-app"
            }
          ],
          "members": [
            {
              "servicePort": 8080,
              "serverAddresses": [
                "10.20.0.11",
                "10.20.0.12"
              ]
            }
          ]
        }
      }
    }
  }
}
